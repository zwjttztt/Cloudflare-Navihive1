# 静态资源响应头（Cloudflare Workers 静态资源会读取本文件）
# 目的：减少重复访问时的校验开销，加快页面加载。

# Vite 产物带内容哈希，可长期强缓存，浏览器不再回源校验
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 入口保持每次校验，保证发版后能立即拿到新版本
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 图标变化不频繁，缓存一天
/vite.ico
  Cache-Control: public, max-age=86400

/vite.svg
  Cache-Control: public, max-age=86400
