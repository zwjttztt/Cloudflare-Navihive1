# 静态资源响应头（Cloudflare Workers 静态资源会读取本文件）
# 分两块：全站安全头（/*）+ 各路径缓存策略。
# 注意：规则按顺序生效，同名头后面覆盖前面，所以安全头放在最前面。

# ---------------------------------------------------------------------------
# 全站安全头
# ---------------------------------------------------------------------------
/*
  # 内容安全策略。几条关键取舍：
  # - style 必须留 'unsafe-inline'：MUI 用的是 emotion，样式是运行时插 <style> 的，
  #   不留这条整个界面会裸奔（去掉后所有组件失去样式）。
  # - script 不需要 'unsafe-inline'：入口是 <script type="module" src>，没有内联脚本。
  # - img / connect 放开 https:：图标 API 和 WebDAV 备份都是用户自己配的第三方 https 地址。
  # - object-src 'none' + base-uri 'self' 挡插件和 <base> 劫持；form-action 'self' 挡表单外投。
  # - require-trusted-types-for 'script'：把 innerHTML / outerHTML / insertAdjacentHTML /
  #   document.write / eval 这些 DOM XSS sink 全部封死——赋值字符串直接抛异常，
  #   只有 Trusted Types 对象能通过。这里**没有**写 trusted-types 指令，
  #   意味着连创建策略都不允许（Chrome 默认 deny），所以不存在「自己造个策略绕过」的路子。
  #   加它之前先扫过全量源码：0 处 innerHTML / eval / new Function / document.write，
  #   React 与 emotion 走的是 createElement 和 CSSOM，不碰这些 sink。
  #   ⚠️ 踩过的坑：Chrome 把 ServiceWorkerContainer.register() 的 scriptURL 也算 sink，
  #   只加 require-trusted-types-for 会让 SW 注册静默失败（控制台报 requires
  #   'TrustedScriptURL'，离线能力直接没了）。所以下面额外给了 trusted-types navihive-sw
  #   这一个策略名，main.tsx 里用它把硬编码的 /sw.js 包成 TrustedScriptURL。
  #   除 SW 之外别再申请策略名——每多一个，TT 的封锁就松一分。
  #   ⚠️ 本条是 enforce 生效：万一将来引入会碰 sink 的依赖，界面会直接白屏，
  #   上线前必须跑一遍全量冒烟（stub 会照发 _headers，本地就能测出来）。
  # - report-uri 指向 Worker 的公开路由：真被拦下的资源会上报一条 JSON，
  #   在 Workers 日志里能搜到（worker/csp.ts），据此再决定要不要继续收紧策略。
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self'; worker-src 'self'; manifest-src 'self'; require-trusted-types-for 'script'; trusted-types navihive-sw; report-uri /api/csp-report
  # 别让浏览器去猜 MIME 类型（把 txt 当 js 执行那一类问题）
  X-Content-Type-Options: nosniff
  # 老的点击劫持防护；现代浏览器看 CSP 的 frame-ancestors，两条一起给，兼容旧客户端
  X-Frame-Options: DENY
  # 跳外链时只带源、不带完整路径
  Referrer-Policy: strict-origin-when-cross-origin
  # 这个站点用不到定位 / 摄像头 / 麦克风，直接关掉
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  # 跨源窗口隔离。打开外链用的是 target=_blank + noopener，本来就不持对方引用，加上无害
  Cross-Origin-Opener-Policy: same-origin
  # 强制 HTTPS：防 SSL stripping / 中间人。includeSubDomains 覆盖子域，preload 进浏览器预加载列表
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # 禁止别的源用 <embed>/<object>/Flash 跨域加载本站资源
  X-Permitted-Cross-Domain-Policies: none
  # 默认不允许跨源（<img>/<script> 等）直接读本站响应体，进一步缩小侧信道面
  Cross-Origin-Resource-Policy: same-origin

# ---------------------------------------------------------------------------
# 缓存策略
# ---------------------------------------------------------------------------

# API 响应一律禁止缓存：含令牌 cookie 的请求结果不能在共享缓存里被复用，
# 否则下一个用户可能拿到前一个用户的 bootstrap 数据。Vary: Cookie 让 CDN/中间代理按
# Cookie 区分缓存键，否则带/不带 cookie 会被错误合并
/api/*
  Cache-Control: no-store
  Vary: Cookie

# Vite 产物带内容哈希，可长期强缓存，浏览器不再回源校验
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# 只有这一页允许 Mermaid 的 DOM sink；强制无同源权限的沙箱、禁止联网/表单。
/mermaid-sandbox*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; sandbox allow-scripts
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/n/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# HTML 入口保持每次校验，保证发版后能立即拿到新版本
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service Worker 不能强缓存，否则发新版后老客户端拿不到新壳子
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 图标与清单：很少变，长缓存（内容稳定，immutable 让浏览器不再回源校验）
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=86400
