# 静态资源响应头（Cloudflare Workers 静态资源会读取本文件）
# 分两块：全站安全头（/*）+ 各路径缓存策略。
# 注意：规则按顺序生效，同名头后面覆盖前面，所以安全头放在最前面。

# ---------------------------------------------------------------------------
# 全站安全头
# ---------------------------------------------------------------------------
/*
  # 内容安全策略。几条关键取舍：
  # - style 必须留 'unsafe-inline'：MUI 用的是 emotion，样式是运行时插 <style> 的，
  #   不留这条整个界面会裸奔（去掉后所有组件失去样式）。
  # - script 不需要 'unsafe-inline'：入口是 <script type="module" src>，没有内联脚本。
  # - img / connect 放开 https:：图标 API 和 WebDAV 备份都是用户自己配的第三方 https 地址。
  #   ⚠️ 这一条**刻意保留 https: 通配**，不做域名白名单（2026-10-26 复核结论）：
  #   站点图标、favicon 抓取、WebDAV 备份目标、AI 端点、媒体外链，全部是**用户运行时
  #   自己填的任意域名**（卡片图标 URL 是导入/手填进来的，WebDAV 地址可以是任何一家
  #   网盘）。换成白名单 = 要么先把这些功能砍掉，要么逼用户在 CSP 里填域名 ——
  #   而这份 _headers 是部署期静态文件，用户改不动。收益那头也很薄：
  #   img-src 的外带只能带一个像素请求的 Referer/URL（本页已有 form-action 'self'
  #   挡表单，script-src 不含内联与第三方，真正的 XSS 外带根本走不通），
  #   connect-src 放开 https: 的代价只有在「已经存在注入点」时才兑现，
  #   而堵这个的正确位置是消灭注入点，不是拿 CSP 兜底。
  #   真要收敛，得先做出「用户可配的 CSP 域名白名单」（配置面 + 前端 + 部署三处联动），
  #   那是个独立改动，不该夹在安全修复里一起上。
  # - object-src 'none' + base-uri 'self' 挡插件和 <base> 劫持；form-action 'self' 挡表单外投。
  # - require-trusted-types-for 'script'：把 innerHTML / outerHTML / insertAdjacentHTML /
  #   document.write / eval 这些 DOM XSS sink 全部封死——赋值字符串直接抛异常，只有
  #   Trusted Types 对象能通过（加它之前扫过全量源码：0 处 sink 调用）。
  #   ⚠️ 踩过的坑：Chrome 把 ServiceWorkerContainer.register() 的 scriptURL 也算 sink，
  #   传字符串会被拒（报 requires 'TrustedScriptURL'），而 main.tsx 的 .catch 会吞掉这个
  #   异常 —— SW 静默不注册、离线失效且无提示。所以 main.tsx 用 createPolicy("navihive-sw")
  #   把硬编码的 /sw.js 包一层再交给 register()。
  #   下面的 trusted-types navihive-sw 是**策略名白名单**，是收紧不是放松：实测该指令缺省时
  #   策略名不受限（createPolicy("任意名") 照样成功），写上它才把可创建的策略名锁死在这一个，
  #   注入代码没法自己造个策略来绕过 TT。⚠️ 硬约束：不能删、不能改成 'none'（删了=名字随便造、
  #   'none'=策略建不出来且 SW 直接失效），也不要追加别的策略名——每多一个，TT 的封锁就松一分。
  #   ⚠️ 本条是 enforce 生效：万一将来引入会碰 sink 的依赖，界面会直接白屏，
  #   上线前必须跑一遍全量冒烟（stub 会照发 _headers，本地就能测出来）。
  # - report-uri 指向 Worker 的公开路由：真被拦下的资源会上报一条 JSON，
  #   在 Workers 日志里能搜到（worker/csp.ts），据此再决定要不要继续收紧策略。
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self'; worker-src 'self'; manifest-src 'self'; require-trusted-types-for 'script'; trusted-types navihive-sw; report-uri /api/csp-report
  # 别让浏览器去猜 MIME 类型（把 txt 当 js 执行那一类问题）
  X-Content-Type-Options: nosniff
  # 老的点击劫持防护；现代浏览器看 CSP 的 frame-ancestors，两条一起给，兼容旧客户端
  X-Frame-Options: DENY
  # 跳外链时只带源、不带完整路径
  Referrer-Policy: strict-origin-when-cross-origin
  # 这个站点用不到定位 / 摄像头 / 麦克风，直接关掉
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  # 跨源窗口隔离。打开外链用的是 target=_blank + noopener，本来就不持对方引用，加上无害
  Cross-Origin-Opener-Policy: same-origin
  # 强制 HTTPS：防 SSL stripping / 中间人。includeSubDomains 覆盖子域，preload 进浏览器预加载列表
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # 禁止别的源用 <embed>/<object>/Flash 跨域加载本站资源
  X-Permitted-Cross-Domain-Policies: none
  # 默认不允许跨源（<img>/<script> 等）直接读本站响应体，进一步缩小侧信道面
  Cross-Origin-Resource-Policy: same-origin

# ---------------------------------------------------------------------------
# 缓存策略
# ---------------------------------------------------------------------------

# API 响应一律禁止缓存：含令牌 cookie 的请求结果不能在共享缓存里被复用，
# 否则下一个用户可能拿到前一个用户的 bootstrap 数据。Vary: Cookie 让 CDN/中间代理按
# Cookie 区分缓存键，否则带/不带 cookie 会被错误合并
/api/*
  Cache-Control: no-store
  Vary: Cookie

# Vite 产物带内容哈希，可长期强缓存，浏览器不再回源校验
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# 只有这一页允许 Mermaid 的 DOM sink；强制无同源权限的沙箱、禁止联网/表单。
/mermaid-sandbox*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; sandbox allow-scripts
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/n/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# HTML 入口：短缓存 60 秒。
#
# 为什么不是「每次校验」：这条链路上一次回源要 2~4.6 秒（实测首页 HTML 首字节 4.58 秒），
# 而入口 HTML 只有几 KB —— 用户每次进站都在为一个「几乎不变的文件」付一次跨境往返。
# 60 秒足够覆盖「刷新一下、开两个标签页」这一类连续访问。
#
# ⚠️ 代价与配套：缓存期内发版，用户最多拿到 60 秒前的旧 HTML。旧 HTML 引用的是
# 旧 chunk（内容哈希命名，CDN 上还在），所以**不会白屏**，只是暂时用旧版本。
# 要立刻生效就在部署后 purge 一次 Cloudflare 缓存；不 purge 的话等 60 秒自动过期。
# 没上 stale-while-revalidate 是刻意的：那会把「拿到旧版本」的窗口拉到好几分钟。
# ⚠️ 2026-10-22 首访体感：加上 stale-while-revalidate。
# 原来是裸的 max-age=60，注释说"没上 SWR 是刻意的"—— 怕旧版窗口拉长。
# 但那个顾虑可以用"短 SWR"解决：max-age 60 + SWR 60 = 最多 2 分钟旧版窗口
# （升级由人点触发，本来就要等镜像，2 分钟完全可接受），
# 换来的是**已缓存的场景零等待**：过期后立刻用旧版渲染，后台静默刷新。
#
# ⚠️ 这一步要和 Cloudflare 的 Cache Rule 配合才完整：CF 默认对 text/html 不缓存
# （cf-cache-status: DYNAMIC），HTML 每次都回源 —— 那 0.5s 是首访 TTFB 的大头。
# 在 CF 配一条 Cache Rules：URI 含 / 且内容是 text/html → Cache Eligibility: Eligible，
#   Edge TTL: 2 minutes, Browser TTL: respect origin
# 之后首访 TTFB 从 ~1000ms 降到 ~520ms（省掉回源那半秒）。
/
  Cache-Control: public, max-age=60, stale-while-revalidate=60

/index.html
  Cache-Control: public, max-age=60, stale-while-revalidate=60

# Service Worker 不能强缓存，否则发新版后老客户端拿不到新壳子
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 图标与清单：很少变，长缓存（内容稳定，immutable 让浏览器不再回源校验）
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=86400
