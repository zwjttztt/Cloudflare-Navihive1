# 沙箱内 tsc 编译单测的临时产物目录
.tmp-check
# 单测打包（esbuild）的临时产物目录
script/tmp-tests
# 恢复私钥（等同万能钥匙，绝不进版本库）
scripts/recovery-private.key
*.recovery-token

# 端到端脚本的 wrangler 本地 state（每次跑会清空）
.wrangler-e2e/

# WebDAV 端到端脚本的 wrangler 本地 state（每次跑新建子目录）
.wrangler-webdav-e2e/

# 定时任务端到端脚本的 wrangler 本地 state（每次跑新建子目录）
.wrangler-cron-e2e/

# 自托管（方案 B）服务端打包产物与本地运行数据
dist-server/
data/
# 自托管冒烟脚本的临时库与附件目录
.smoke-data/
# compose 的密钥来源（.env.example 是模板，要提交）
.env
**/.env
# 单向镜像同步的状态文件（含两端地址，监控看它的 mtime 判定新鲜度）
mirror-sync-state.json
