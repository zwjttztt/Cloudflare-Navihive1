{
  "name": "navihive",
  "private": true,
  "version": "11.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "sync:brand": "node script/sync-brand.mjs",
    "check:brand": "node script/sync-brand.mjs --check",
    "test": "node script/unit-tests.mjs",
    "check:budget": "node script/unit-tests.mjs bundleBudget",
    "smoke": "node script/ci-smoke.mjs",
    "smoke:prod": "node script/prod-smoke.mjs",
    "smoke:selfhost": "node script/selfhost-smoke.mjs",
    "audit:a11y": "node script/a11y-audit.mjs",
    "audit:contrast": "node script/contrast-audit.mjs",
    "audit:perf": "node script/perf-audit.mjs",
    "audit:visual": "node script/visual-regression.mjs",
    "probe:edge": "npm run build:server && node script/api-edge-probe.mjs",
    "coverage": "node script/coverage.mjs",
    "e2e": "node script/api-e2e.mjs",
    "e2e:share": "node script/share-e2e.mjs",
    "e2e:share-extra": "npm run build:server && node script/share-e2e-extra.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run check:brand && npm run build && npm run check:budget && npm run e2e && npm run e2e:share && npm run e2e:share-extra && npm run e2e:cron && npm run smoke && npm run audit:a11y && npm run audit:contrast && npm run audit:perf && npm run e2e:webdav",
    "lint": "eslint . && node script/lint-warnings-budget.mjs",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "reset-admin": "node scripts/reset-admin-password.mjs",
    "recovery": "node scripts/recovery-token.mjs",
    "e2e:webdav": "node script/webdav-e2e.mjs",
    "e2e:cron": "node script/cron-e2e.mjs",
    "build:server": "node script/build-server.mjs",
    "start:selfhost": "npm run build:server && node --disable-warning=ExperimentalWarning dist-server/entry.mjs",
    "check:whitedot": "node script/white-dot-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "katex": "^0.19.0",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.1.0",
    "pinyin-match": "^1.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "mermaid": {
      "katex": "0.19.0"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "wrangler": "^4.146.0"
  }
}
