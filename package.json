{
    "name": "navihive",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc -b",
        "build": "tsc -b && vite build",
        "test": "node script/unit-tests.mjs",
        "smoke": "node script/ci-smoke.mjs",
        "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke",
        "lint": "eslint .",
        "preview": "npm run build && vite preview",
        "deploy": "npm run build && wrangler deploy",
        "cf-typegen": "wrangler types",
        "reset-admin": "node scripts/reset-admin-password.mjs",
        "recovery": "node scripts/recovery-token.mjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^7.3.11",
        "@mui/material": "^7.3.11",
        "pinyin-match": "^1.2.10",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.0.0",
        "@cloudflare/workers-types": "^4.20250405.0",
        "@eslint/js": "^9.21.0",
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "esbuild": "^0.25.2",
        "eslint": "^9.21.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "jsdom": "^30.1.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.4.3",
        "wrangler": "^4.144.0"
    }
