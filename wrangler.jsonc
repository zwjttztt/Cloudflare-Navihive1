/**
 * Cloudflare Workers 配置文件 —— 个人导航站 (NaviHive)
 *
 * 部署前请修改：
 *   1. "name"          项目名（将显示在 https://<name>.<用户名>.workers.dev）
 *   2. database_id     你的 D1 数据库 ID（使用一键部署流程会自动创建，可跳过）
 *   3. vars 中的认证信息（务必改成自己的账号密码与随机密钥）
 *
 * 关于账号密码（重要）：
 *   vars 里的 AUTH_USERNAME / AUTH_PASSWORD 只作为「第一次部署」的默认账号密码，
 *   首次登录时会自动写进 D1 的 configs 表（auth.username / auth.password）。
 *   之后以数据库为准：再怎么重新部署、或者把 vars 改成别的值，都不会改动已生效的账号密码。
 *   需要改密码请到站内「网站设置 → 管理员账号与密码」，或用 wrangler 直接改表里这两行。
 *
 * 详见仓库 README.md 的部署指南。
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "myhomepage",
    "main": "worker/index.ts",
    "compatibility_date": "2025-04-05",
    "assets": {
        "not_found_handling": "single-page-application"
    },
    "observability": {
        "enabled": true
    },
    // D1 数据库绑定
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "navigation-db",
            "database_id": "e4f73ada-564f-4a37-89a7-52729d2e8c07"
        }
    ],
    // 每周一 UTC 02:00（北京时间 10:00）自动备份一次到 WebDAV。
    // 开关在页面「备份与恢复 → 每周自动备份」，需要重新部署才会应用这里的改动。
    "triggers": {
        "crons": [
            "0 2 * * 1"
        ]
    },
    "vars": {
        // 忘记密码时的应急重置码，别写在 vars 里（会明文进 Git），用命令存成加密的 secret：
        //   wrangler secret put AUTH_RESET_CODE
        // 设置后登录页会出现「忘记密码？用应急重置码找回」，填入该码即可重设管理员密码。
        "AUTH_ENABLED": "true",
        "AUTH_USERNAME": "admin",
        "AUTH_PASSWORD": "j55XeeGvQZJXf3",
        "AUTH_SECRET": "c105742af3b1792e0caaa46d72329496911f62757f7c50893b1245e8015d2002"
    }
}
