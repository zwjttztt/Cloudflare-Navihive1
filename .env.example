# NaviHive 自托管环境变量模板。复制成 .env 再改：cp .env.example .env
# .env 含密钥，已在 .gitignore 与 .dockerignore 中，别提交、别打进镜像。
# 完整说明见 deploy/selfhost.md 第三节。

# ===== 必配 =====
# 令牌签名 + 数据加密。从 D1 迁数据时必须与线上完全一致，否则已加密凭据解不开。
# 生成：openssl rand -hex 32
AUTH_SECRET=

# ===== 首次建库的种子账号（库已存在则忽略，以 configs 表为准）=====
AUTH_USERNAME=root
AUTH_PASSWORD=

# ===== 监听与网络 =====
# 宿主机映射端口（compose 只绑 127.0.0.1，TLS 交给前面的 Nginx/Caddy）
NAVIHIVE_PORT=8787
# 是否信任反代写的客户端 IP 头。默认 0（安全）：端口直接暴露公网时保持 0，
# 否则改个请求头就能换一个限速桶、绕开爆破防护。
# ⚠️ 只有反代以**覆盖模式**写 `X-Forwarded-For $remote_addr` **且**写了
#    `X-Real-IP $remote_addr` 时，才把 NAVIHIVE_TRUST_XFF 与
#    NAVIHIVE_TRUST_X_REAL_IP 同时设为 1（本仓 deploy/nginx/ 模板满足条件）。
#    追加模式（$proxy_add_x_forwarded_for）下 XFF 首段仍是客户端伪造的，
#    攻击者每次随机换一个就能换一个限速桶，爆破锁全部失效。
NAVIHIVE_TRUST_XFF=0
# 只控制「要不要读 X-Real-IP」这个头，与上面的开关独立（默认 0）。
# 它本身也是客户端可填的头：反代没覆盖写（Caddy / Traefik 默认不写）时，
# 只开 TRUST_XFF 而开这个，等于让客户端自带的 X-Real-IP 决定限速分桶键。
NAVIHIVE_TRUST_X_REAL_IP=0

# ===== 定时任务 =====
# 单实例保持 1（进程内每小时一轮）；多副本必须设 0 并配 token，改用 POST /__cron 外部触发
NAVIHIVE_CRON=1
NAVIHIVE_CRON_TOKEN=

# ===== 迁移相关（从 D1 搬数据才需要，必须与线上一致）=====
DATA_ENCRYPTION_KEY=
JWT_SECRET=
